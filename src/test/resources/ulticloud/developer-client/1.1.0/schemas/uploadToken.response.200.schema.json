{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/rest/v1/developer-client/1.1.0/uploadToken.response.200.schema.json",
  "type": "object",
  "properties": {
    "data": {
      "$ref": "#/$defs/UploadTicket"
    }
  },
  "required": [
    "data"
  ],
  "additionalProperties": false,
  "$defs": {
    "UploadTicket": {
      "type": "object",
      "properties": {
        "uploadUrl": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https:\\/\\/[^\\x00-\\x20\\x7F-\\x9F/?#]+([/?#][^\\x00-\\x20\\x7F-\\x9F]*)?$"
        },
        "method": {
          "type": "string",
          "const": "PUT"
        },
        "headers": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "expiresAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "maxBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "uploadUrl",
        "method",
        "headers",
        "expiresAt",
        "maxBytes"
      ],
      "additionalProperties": false
    }
  }
}
