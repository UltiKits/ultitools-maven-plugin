            },
            "downloadUrl": {
              "type": "null"
            },
            "isLatest": {
              "type": "boolean",
              "const": false
            },
            "withdrawnAt": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            }
          },
          "required": [
            "version",
