{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/rest/v1/developer-client/1.0.0/modulesDelete.response.200.schema.json",
  "type": "object",
  "properties": {
    "data": {
      "$ref": "#/$defs/ModuleDeletion"
    }
  },
  "required": [
    "data"
  ],
  "additionalProperties": false,
  "$defs": {
    "ModuleDeletion": {
      "type": "object",
      "properties": {
        "deletedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "restorableUntil": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        }
      },
      "required": [
        "deletedAt",
        "restorableUntil"
      ],
      "additionalProperties": false
    }
  }
}
