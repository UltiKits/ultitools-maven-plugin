{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/rest/v1/developer-client/1.0.0/versionsWithdraw.response.200.schema.json",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "version": {
          "$ref": "#/$defs/DevModuleVersion"
        }
      },
      "required": [
        "version"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "data"
  ],
  "additionalProperties": false,
  "$defs": {
    "DevModuleVersion": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending_upload",
            "published",
            "yanked"
          ]
        },
        "isLatest": {
          "type": "boolean"
        },
        "sizeBytes": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "changelog": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 20000
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "downloadUrl": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^https:\\/\\/[^\\x00-\\x20\\x7F-\\x9F/?#]+([/?#][^\\x00-\\x20\\x7F-\\x9F]*)?$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "status",
        "isLatest",
        "sizeBytes",
        "sha256",
        "changelog",
        "createdAt",
        "downloadUrl"
      ],
      "additionalProperties": false
    }
  }
}
