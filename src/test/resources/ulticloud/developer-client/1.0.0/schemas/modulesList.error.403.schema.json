{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/rest/v1/developer-client/1.0.0/modulesList.error.403.schema.json",
  "type": "object",
  "properties": {
    "error": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "role_required"
            },
            "message": {
              "type": "string",
              "maxLength": 500
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "details": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "owner",
                    "developer"
                  ]
                }
              },
              "required": [
                "role"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "code",
            "message",
            "requestId",
            "details"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "error"
  ],
  "additionalProperties": false
}
