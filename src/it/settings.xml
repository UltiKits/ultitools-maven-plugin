<?xml version="1.0" encoding="UTF-8"?>
<!-- Lets the integration-test builds resolve the plugin under test from the IT local repository. -->
<settings>
  <profiles>
    <profile>
      <id>it-repo</id>
      <activation><activeByDefault>true</activeByDefault></activation>
      <repositories>
        <repository><id>local.central</id><url>@localRepositoryUrl@</url>
          <releases><enabled>true</enabled></releases><snapshots><enabled>true</enabled></snapshots></repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository><id>local.central</id><url>@localRepositoryUrl@</url>
          <releases><enabled>true</enabled></releases><snapshots><enabled>true</enabled></snapshots></pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
</settings>
